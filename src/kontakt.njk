---
layout: base.njk
title: Kontakt
description: Napište nám, co řešíte. Ozveme se a domluvíme nezávaznou konzultaci.
---
<section class="container contact">
  {% set variant = "soft" %}{% include "waves.njk" %}
  <div class="contact-info">
    <span class="pill reveal"><i></i>Kontakt</span>
    <h1 class="reveal">Pojďme to <span class="grad">probrat</span></h1>
    <p class="lead reveal">Napište nám, co řešíte. Ozveme se a domluvíme nezávaznou konzultaci.</p>
    <ul class="contact-list reveal">
      <li><span class="icon icon--web"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      <li><span class="icon icon--digital"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg></span><a href="tel:{{ site.phone | tel }}">{{ site.phone }}</a></li>
      <li class="muted"><span class="icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4h10v17M15 9h4v12M8 8h4M8 12h4M8 16h4M3 21h18"/></svg></span>{{ site.name }} · IČO: {{ site.ico }} · {{ site.address }}</li>
    </ul>
  </div>

  <form class="form reveal" id="contact-form" data-key="{{ site.formKey }}" data-email="{{ site.email }}" novalidate>
    <input type="hidden" name="subject" value="Nová poptávka z webu MARELI">
    <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">
    <label>Jméno<input name="name" required autocomplete="name"></label>
    <label>E-mail<input name="email" type="email" required autocomplete="email"></label>
    <label>Co vás zajímá
      <select name="topic">
        <option>Web &amp; Development</option>
        <option>AI &amp; Automation</option>
        <option>Digital Content</option>
        <option>Něco jiného</option>
      </select>
    </label>
    <label>Zpráva<textarea name="message" rows="6" required></textarea></label>
    <button class="btn btn--primary btn--block" type="submit">Odeslat poptávku</button>
    <p class="form-note">Odesláním formuláře berete na vědomí <a href="/ochrana-osobnich-udaju/">zpracování osobních údajů</a> za účelem vyřízení poptávky.</p>
    <p class="form-status" role="status" aria-live="polite"></p>
  </form>
</section>
